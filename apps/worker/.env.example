# Optional: copy to .env — `worker.py` also loads the monorepo root `../../.env` (see `REDIS_URL` there).
# Celery needs a reachable Redis (default below matches docker-compose infra).

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# If only REDIS_URL is set at repo root, worker.py maps it to CELERY_BROKER_URL automatically.

# Dev without Redis (in-memory broker; not for production):
# AXIOM_DEV_MEMORY_BROKER=1

# Disable Docker auto-start of Redis in worker.py preflight:
# AXIOM_AUTO_START_REDIS=0

# Skip startup Redis ping (only if you know what you're doing):
# SKIP_REDIS_PREFLIGHT=1

# Optional override — prefer repo root .env. Must match API DATABASE_URL (same logical database).
# DATABASE_URL=postgresql+asyncpg://postgres:@127.0.0.1:5435/axiom

# If Celery cannot find the monorepo root, point it at the repo (directory that contains apps/api):
# AXIOM_REPO_ROOT=/absolute/path/to/axiom
