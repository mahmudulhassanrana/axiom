# Optional: copy to apps/api/.env for overrides.
# ``main.py`` also loads the monorepo root ``../../.env`` first, so DATABASE_URL can live only in the repo root.

DATABASE_URL=postgresql+asyncpg://postgres:@127.0.0.1:5435/axiom
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

JWT_SECRET_KEY=change-me-to-a-long-random-string-for-local-dev
# API_KEY_PEPPER=
# 1440 = 24 hours
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Create tables from SQLAlchemy metadata on startup (disable in prod if you use Alembic only)
AXIOM_AUTO_CREATE_SCHEMA=true
# Idempotent default admin (admin@axiom.local / admin123); disable in production
AXIOM_SEED_DEFAULT_ADMIN=true

# Optional: omit ENVIRONMENT or use "development" for relaxed settings
# ENVIRONMENT=development

# Compliance (optional)
# COMPLIANCE_ENABLED=true
# COMPLIANCE_REDIS_URL=redis://localhost:6379/0
