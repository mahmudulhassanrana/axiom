# Copy to .env.local for Next.js dev (npm run dev)
#
# Recommended: leave NEXT_PUBLIC_API_URL unset so the app calls same-origin `/api/*`
# (Next.js rewrites to FastAPI — no CORS, works when the API is on 127.0.0.1:8000).
#
# Optional direct API URL (cross-origin; ensure CORS_ALLOW_ORIGINS includes this app).
# Also used as the WebSocket base for live job updates (/ws/jobs/...); if unset, the UI uses ws://<host>:8000.
# NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Rewrite target (server-side only; default http://127.0.0.1:8000):
# API_PROXY_TARGET=http://127.0.0.1:8000
