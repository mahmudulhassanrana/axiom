# Combined example for tooling that loads env from the repo root.
# Prefer the focused templates: apps/api/.env.example and apps/web/.env.example
#
# API (FastAPI)
# ENVIRONMENT=production   # when set to production: strong JWT secret required; API docs off unless API_DOCS_ENABLED=true
# CORS_ALLOW_ORIGINS=http://localhost:3000,https://app.example.com
# API_DOCS_ENABLED=false     # in production, set true to expose /docs and /openapi.json
# MAX_REQUEST_BODY_BYTES=10485760
# ENABLE_HSTS=true           # set behind HTTPS termination; adds Strict-Transport-Security
# JWT_ISSUER=axiom
# JWT_AUDIENCE=axiom-api
#
# Logging (axiom_api logger): LOG_FORMAT=json for log aggregators; LOG_LEVEL=INFO|DEBUG|WARNING
# LOG_ACCESS_LOG=true      # set false to disable one-line http_request access logs
# LOG_ACCESS_SKIP_PATHS=/health,/metrics   # comma paths to exclude from access logs (default /health)
API_HOST=0.0.0.0
API_PORT=8000
# Same URL for API (asyncpg) and Celery worker (worker strips +asyncpg for psycopg).
DATABASE_URL=postgresql+asyncpg://postgres:@127.0.0.1:5435/axiom
# Redis (API + Celery). Docker: ./scripts/run-redis.sh  |  Homebrew: brew install redis && brew services start redis
REDIS_URL=redis://localhost:6379/0

# JWT (required in production). If unset, a development-only default is used (not for production).
JWT_SECRET_KEY=change-me-in-production
# Optional: separate pepper for API key hashing; defaults to JWT_SECRET_KEY when unset.
# API_KEY_PEPPER=
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Scraping compliance (shared by API + worker). Rate limiting requires Redis.
# COMPLIANCE_ENABLED=true
# COMPLIANCE_USER_AGENT=AxiomExtractor/0.1 (+https://example.com)
# COMPLIANCE_DOMAIN_BLOCKLIST=malicious.example,ads.example
# COMPLIANCE_DOMAIN_ALLOWLIST=
# COMPLIANCE_REQUEST_DELAY_SECONDS=0
# COMPLIANCE_REQUEST_JITTER_SECONDS=0.35
# COMPLIANCE_RATE_LIMIT_PER_DOMAIN=30
# COMPLIANCE_RATE_LIMIT_WINDOW_SECONDS=60
# COMPLIANCE_REDIS_URL=redis://localhost:6379/0
# COMPLIANCE_ROBOTS_FAIL_OPEN=true
# COMPLIANCE_ROBOTS_TIMEOUT_SECONDS=10

# Celery (worker consumes; API publishes async scrape jobs)
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Web (Next.js). For `infra/docker-compose.yml`, export this before `docker compose build web`
# to bake the browser-facing API origin into the image (default in compose is http://localhost:8000).
NEXT_PUBLIC_API_URL=http://localhost:8000
